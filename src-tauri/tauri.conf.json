{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreelanceDesk",
  "version": "0.0.1",
  "identifier": "com.carlodandan.freelancedesk",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FreelanceDesk",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczRjkxMjA0RkMyMTUwRDYKUldUV1VDSDhCQkw1YzlPZ3FBRm9tZ3ZuU1MwaHhZblY5bGlXZDc1S2s2dnBmb0k3RTB2TzBidFcK",
      "endpoints": [
        "https://github.com/carlodandan/freelancedesk/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "active": true
    }
  }
}
